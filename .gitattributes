* text=auto eol=lf
*.bat text eol=crlf
*.bin binary
*.c48b binary
*.tap binary
*.docx binary
*.zip binary

# Large image evidence/assets live in Git LFS. Text metadata beside them remains
# ordinary Git so release evidence and diffs stay directly inspectable.
docs/images/** filter=lfs diff=lfs merge=lfs -text
screenshots/**/*.png filter=lfs diff=lfs merge=lfs -text
screenshots/**/*.jpg filter=lfs diff=lfs merge=lfs -text
screenshots/**/*.jpeg filter=lfs diff=lfs merge=lfs -text
screenshots/**/*.webp filter=lfs diff=lfs merge=lfs -text
screenshots/**/*.ppm filter=lfs diff=lfs merge=lfs -text
